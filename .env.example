# Postgres (Neon) — connection string completa, uma linha
DATABASE_URL=

# Telegram (opcional — sem isso, alertas vão para o console)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Agendamento (monitor.py --schedule)
SCHEDULE_HOUR=9
SCHEDULE_MINUTE=0

# Falhas seguidas de scrape antes de avisar no Telegram (padrao 3)
SCRAPE_FAILURE_ALERT_AFTER=3
